# chain service: the ONLY service that holds blockchain keys.
# Copy to .env (git-ignored). Never commit real values, never paste them in chats or issues.

# testnet while learning. A mainnet key must NEVER be in a file: use a KMS/HSM or secret manager.
HEDERA_NETWORK=testnet

# Operator = the account that pays network fees. Keep only a small balance on it.
# Check the exact account id format and key type (ECDSA vs ED25519) in the Hedera portal.
HEDERA_OPERATOR_ID=0.0.xxxxx
HEDERA_OPERATOR_KEY=
HEDERA_EVM_ADDRESS=
