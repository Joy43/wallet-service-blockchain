DATABASE_URL=postgres://auth:auth@localhost:5432/auth?sslmode=disable
NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=DEBUG
SHUTDOWN_TIMEOUT=15s

AUTH_HTTP_ADDR=:8081
AUTH_GRPC_LISTEN_ADDR=:9090

# REQUIRED. Ed25519 signing key. Generate with: make keygen   (paste only the value after '=')
# Never commit a real key. Other services need only the PUBLIC key from /.well-known/jwks.json.
JWT_PRIVATE_KEY=
JWT_KEY_ID=auth-1
JWT_ISSUER=auth-service

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=1m
BCRYPT_COST=12
